<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zcode-task-queue</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd '/REPLACE/WITH/zcode-task-queue' &amp;&amp; exec node server.js</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/REPLACE/WITH/zcode-task-queue/server.log</string>
    <key>StandardErrorPath</key>
    <string>/REPLACE/WITH/zcode-task-queue/server.log</string>
</dict>
</plist>
